{%- doc -%}
  Renders a free-shipping progress bar at the top of the cart.
  Reads settings.free_shipping_threshold (CAD value, e.g. 95).
  Auto-updates when cart-items-component re-renders the section.
{%- enddoc -%}

{%- liquid
  assign threshold_dollars = settings.free_shipping_threshold | default: 0
  assign threshold_cents = threshold_dollars | times: 100

  if threshold_cents <= 0 or cart.empty?
    assign show_bar = false
  else
    assign show_bar = true
  endif
-%}

{%- if show_bar -%}
  {%- liquid
    assign current = cart.total_price
    assign remaining = threshold_cents | minus: current
    if remaining < 0
      assign remaining = 0
    endif
    assign progress = current | times: 100.0 | divided_by: threshold_cents
    if progress > 100
      assign progress = 100
    endif
    assign unlocked = false
    if current >= threshold_cents
      assign unlocked = true
    endif
  -%}

  <div class="free-shipping-bar{% if unlocked %} free-shipping-bar--unlocked{% endif %}" role="status">
    <p class="free-shipping-bar__message">
      {%- if unlocked -%}
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8l3 3 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        {{ settings.free_shipping_unlocked_text | default: "You've unlocked free shipping!" }}
      {%- else -%}
        {%- assign remaining_money = remaining | money -%}
        {%- assign template = settings.free_shipping_progress_text | default: "You're {{ remaining }} away from free shipping." -%}
        {{ template | replace: '{{ remaining }}', remaining_money }}
      {%- endif -%}
    </p>
    <div class="free-shipping-bar__track" aria-hidden="true">
      <div class="free-shipping-bar__fill" style="width: {{ progress }}%;"></div>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .free-shipping-bar {
    padding: 0.875rem 0;
    margin-block-end: var(--margin-md, 1rem);
    border-block-end: 1px solid rgb(var(--color-border-rgb, 0 0 0) / 0.15);
  }

  .free-shipping-bar__message {
    margin: 0 0 0.55rem;
    font-size: 0.875rem;
    line-height: 1.4;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .free-shipping-bar__message svg {
    flex-shrink: 0;
    color: #2e7d32;
  }

  .free-shipping-bar--unlocked .free-shipping-bar__message {
    color: #2e7d32;
    font-weight: 500;
  }

  .free-shipping-bar__track {
    width: 100%;
    height: 4px;
    background: rgb(var(--color-foreground-rgb, 0 0 0) / 0.08);
    border-radius: 2px;
    overflow: hidden;
  }

  .free-shipping-bar__fill {
    height: 100%;
    background: var(--color-foreground, currentColor);
    border-radius: 2px;
    transition: width 300ms ease-out;
  }

  .free-shipping-bar--unlocked .free-shipping-bar__fill {
    background: #2e7d32;
  }
{% endstylesheet %}
