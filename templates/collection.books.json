xbw6GE","button_3gBMzc"]}},"name":"t:names.editorial","settings":{"media_position":"left","media_width":"medium","media_height":"60svh","section_width":"full-width","extend_media":true,"color_scheme":"scheme-4","padding-block-start":0,"padding-block-end":0}},"custom_liquid_VFebUa":{"type":"custom-liquid","custom_css":[],"name":"t:names.custom_liquid","settings":{"custom_liquid":"<!-- HTML Structure with Three Testimonials -->\n<p>\n<p>\n<section class=\"book-testimonials\">\n  <h2 class=\"book-testimonials__title\" style=\"text-align: center;\">What Readers Are Discovering<\/h2>\n  \n  <div class=\"testimonials-grid\">\n    \n    <!-- Testimonial 1: Intellectual Depth -->\n    <div class=\"testimonial-card\">\n      <div class=\"testimonial__stars\">\n        <span class=\"star\">★<\/span>\n        <span class=\"star\">★<\/span>\n        <span class=\"star\">★<\/span>\n        <span class=\"star\">★<\/span>\n        <span class=\"star\">★<\/span>\n      <\/div>\n      <span class=\"testimonial__book-tag\">From Junk to Genius<\/span>\n      <p class=\"testimonial__quote\">\n        Finally, someone who doesn't dumb it down. This book weaves quantum biology, epigenetics, and philosophy without losing scientific rigor or spiritual depth. I've read it three times and each pass reveals new layers. It's rare to find work that respects both my mind and my soul.\n      <\/p>\n      <div class=\"testimonial__meta\">\n        <div class=\"testimonial__author\">Dr. Michelle Chen<\/div>\n        <div class=\"testimonial__location\">Seattle, WA<\/div>\n      <\/div>\n    <\/div>\n<p><p>\n\n    <!-- Testimonial 2: Emotional Impact -->\n    <div class=\"testimonial-card\">\n      <div class=\"testimonial__stars\">\n        <span class=\"star\">★<\/span>\n        <span class=\"star\">★<\/span>\n        <span class=\"star\">★<\/span>\n        <span class=\"star\">★<\/span>\n        <span class=\"star\">★<\/span>\n      <\/div>\n      <span class=\"testimonial__book-tag\">Saqi<\/span>\n      <p class=\"testimonial__quote\">\n        I cried reading the garden chapter. Not sad tears—tears of recognition. Like my body remembered something my mind had forgotten. The poetry doesn't explain presence, it creates it. I keep this book on my meditation altar now.\n      <\/p>\n      <div class=\"testimonial__meta\">\n        <div class=\"testimonial__author\">James Okafor<\/div>\n        <div class=\"testimonial__location\">Austin, TX<\/div>\n      <\/div>\n    <\/div>\n<p><p>\n    <!-- Testimonial 3: Practical Transformation -->\n    <div class=\"testimonial-card\">\n      <div class=\"testimonial__stars\">\n        <span class=\"star\">★<\/span>\n        <span class=\"star\">★<\/span>\n        <span class=\"star\">★<\/span>\n        <span class=\"star\">★<\/span>\n        <span class=\"star\">★<\/span>\n      <\/div>\n      <span class=\"testimonial__book-tag\">Both Books<\/span>\n      <p class=\"testimonial__quote\">\n        These books changed how I see my body—not as something to fix or optimize, but as a sacred vessel carrying ancient intelligence. I stopped fighting myself and started listening. That shift alone has been worth everything. Read them together; they complete each other.\n      <\/p>\n      <div class=\"testimonial__meta\">\n        <div class=\"testimonial__author\">Sarah Patel<\/div>\n        <div class=\"testimonial__location\">Portland, OR<\/div>\n      <\/div>\n    <\/div>\n\n  <\/div>\n<p>\n<p>\n<p>\n<p>\n<\/section>","color_scheme":"","section_width":"page-width","padding-block-start":0,"padding-block-end":0}}},"order":["hero_eHqnFY","section","main","media_with_content_dTatXC","media_with_content_C4d3d6","custom_liquid_VFebUa"]}