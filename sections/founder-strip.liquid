
<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section class="founder-strip color-{{ section.settings.color_scheme }} page-width" aria-labelledby="founder-strip-heading-{{ section.id }}">
  <div class="founder-strip__grid founder-strip--media-{{ section.settings.media_position }}">
    <div class="founder-strip__media">
      {%- if section.settings.portrait_image != blank -%}
        {{
          section.settings.portrait_image
          | image_url: width: 1200
          | image_tag:
            loading: 'lazy',
            sizes: '(min-width: 750px) 50vw, 100vw',
            widths: '375, 540, 750, 990, 1200',
            class: 'founder-strip__image',
            alt: section.settings.portrait_image.alt | default: section.settings.heading
        }}
      {%- else -%}
        <img
          src="{{ 'founder-portrait.png' | asset_url }}"
          alt="Founder of Original 1%"
          class="founder-strip__image"
          loading="lazy"
          width="1200"
          height="1500"
        >
      {%- endif -%}
    </div>

    <div class="founder-strip__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="founder-strip__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="founder-strip__heading" id="founder-strip-heading-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- else -%}
        <h2 class="visually-hidden" id="founder-strip-heading-{{ section.id }}">Our story</h2>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <div class="founder-strip__body rte">{{ section.settings.body }}</div>
      {%- endif -%}

      {%- if section.settings.signature != blank -%}
        <p class="founder-strip__signature">{{ section.settings.signature }}</p>
      {%- endif -%}

      {%- if section.settings.cta_text != blank -%}
        <a href="{{ section.settings.cta_link | default: '#' }}" class="founder-strip__cta">
          {{ section.settings.cta_text }}
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M3 7h8m0 0L8 4m3 3L8 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .founder-strip {
    padding-block: 4rem;
  }

  .founder-strip__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }

  .founder-strip__media {
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.04);
  }

  .founder-strip__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .founder-strip__image--placeholder {
    background: linear-gradient(135deg, rgba(0,0,0,0.08), rgba(0,0,0,0.02));
  }

  .founder-strip__content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .founder-strip__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 0.75rem;
    font-weight: 500;
    margin: 0;
    opacity: 0.7;
  }

  .founder-strip__heading {
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    line-height: 1.25;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .founder-strip__body {
    font-size: 1rem;
    line-height: 1.6;
    opacity: 0.9;
  }

  .founder-strip__body p {
    margin: 0 0 1rem;
  }

  .founder-strip__body p:last-child {
    margin-bottom: 0;
  }

  .founder-strip__signature {
    font-style: italic;
    margin: 0.25rem 0 0;
    opacity: 0.85;
  }

  .founder-strip__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.5rem;
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 4px;
    color: inherit;
    width: fit-content;
  }

  .founder-strip__cta:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .founder-strip__cta:hover svg {
    transform: translateX(3px);
  }

  .founder-strip__cta svg {
    transition: transform 150ms ease;
  }

  @media (min-width: 750px) {
    .founder-strip__grid {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }

    .founder-strip--media-right .founder-strip__media {
      order: 2;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Founder strip",
  "tag": "section",
  "class": "section-founder-strip",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "portrait_image",
      "label": "Portrait image",
      "info": "Recommended 4:5 portrait crop."
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Image position (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why this exists"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Two generations in service of natural health."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>My name is Iman Pour Navab, and I named this company DYNAMISE — it means 'energized.' I learned the art of extraction and natural supplements from my father, a pharmacist. I studied a six-year natural medicine program at the CCHH in Ontario. I'm a botanist, herbalist, and registered homeopath. Original 1% carries that lineage forward: clean, esthetician-formulated, made by hand in our own Health-Canada-registered Canadian facility. The 1% is the part of you that's irreplaceable. This is for that part.</p>"
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Signature line",
      "default": "— Iman Pour Navab, Founder, DYNAMISE®"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA label",
      "default": "Read the full story"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Founder strip"
    }
  ]
}
{% endschema %}
