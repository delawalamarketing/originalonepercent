
<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section class="reviews-wall color-{{ section.settings.color_scheme }} page-width">
  <header class="reviews-wall__header">
    {%- if section.settings.eyebrow != blank -%}
      <p class="reviews-wall__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="reviews-wall__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="reviews-wall__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
  </header>

  <div class="reviews-wall__widget">
    {%- comment -%} Klaviyo or Judge.me reviews widget embed goes here {%- endcomment -%}
    <!-- APP EMBED: Reviews widget (Judge.me / Loox / Klaviyo) -->

    {%- if section.settings.show_empty_state -%}
      <div class="reviews-wall__empty">
        <p class="reviews-wall__empty-text">{{ section.settings.empty_text }}</p>
        {%- if section.settings.empty_cta_text != blank -%}
          <a href="{{ section.settings.empty_cta_link | default: '/collections/all' }}" class="reviews-wall__empty-cta">
            {{ section.settings.empty_cta_text }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .reviews-wall {
    padding-block: 4rem;
  }

  .reviews-wall__header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 2.5rem;
  }

  .reviews-wall__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 0.75rem;
    font-weight: 500;
    margin: 0 0 0.75rem;
    opacity: 0.7;
  }

  .reviews-wall__heading {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0 0 0.75rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .reviews-wall__subheading {
    font-size: 1rem;
    line-height: 1.55;
    margin: 0;
    opacity: 0.85;
  }

  .reviews-wall__widget {
    min-height: 80px;
  }

  .reviews-wall__empty {
    text-align: center;
    padding: 3rem 1.5rem;
    border: 1px dashed rgba(0, 0, 0, 0.15);
    border-radius: 4px;
  }

  .reviews-wall__empty-text {
    font-size: 1rem;
    margin: 0 0 1rem;
    opacity: 0.85;
  }

  .reviews-wall__empty-cta {
    display: inline-flex;
    align-items: center;
    padding: 0.85rem 1.5rem;
    background: currentColor;
    color: var(--color-background, #fff);
    text-decoration: none;
    border-radius: 2px;
    font-size: 0.9375rem;
    font-weight: 500;
    min-height: 44px;
  }

  .reviews-wall__empty-cta > * {
    color: var(--color-background, #fff);
  }

  .reviews-wall__empty-cta:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Reviews wall",
  "tag": "section",
  "class": "section-reviews-wall",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Paste your reviews app embed (Judge.me, Loox, Klaviyo) into this section's HTML in code, where the comment placeholder is."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Optional — leave blank to hide."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stories from our community."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "info": "Optional — leave blank to hide."
    },
    {
      "type": "header",
      "content": "Empty state"
    },
    {
      "type": "checkbox",
      "id": "show_empty_state",
      "label": "Show empty state",
      "default": true,
      "info": "Disable once your reviews app embed is live."
    },
    {
      "type": "textarea",
      "id": "empty_text",
      "label": "Empty-state text",
      "default": "Be one of the first to share yours."
    },
    {
      "type": "text",
      "id": "empty_cta_text",
      "label": "Empty-state CTA",
      "default": "Shop our products"
    },
    {
      "type": "url",
      "id": "empty_cta_link",
      "label": "Empty-state CTA link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Reviews wall"
    }
  ]
}
{% endschema %}
