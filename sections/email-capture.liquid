
<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section class="email-capture color-{{ section.settings.color_scheme }} page-width" aria-labelledby="email-capture-heading-{{ section.id }}">
  <div class="email-capture__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="email-capture__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="email-capture__heading" id="email-capture-heading-{{ section.id }}">{{ section.settings.heading }}</h2>
    {%- else -%}
      <h2 class="visually-hidden" id="email-capture-heading-{{ section.id }}">Get our free guide</h2>
    {%- endif -%}

    {%- if section.settings.body != blank -%}
      <p class="email-capture__body">{{ section.settings.body }}</p>
    {%- endif -%}

    <div class="email-capture__form-wrapper">
      {%- comment -%} Klaviyo form embed goes here {%- endcomment -%}
      <!-- APP EMBED: Klaviyo form goes here -->

      {%- form 'customer', id: 'EmailCapture-' | append: section.id, class: 'email-capture__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter, lead-magnet">
        <label for="EmailCapture-{{ section.id }}-email" class="visually-hidden">{{ section.settings.placeholder | default: 'Email' }}</label>
        <input
          id="EmailCapture-{{ section.id }}-email"
          type="email"
          name="contact[email]"
          placeholder="{{ section.settings.placeholder | default: 'you@example.com' | escape }}"
          autocorrect="off"
          autocapitalize="off"
          autocomplete="email"
          required
          class="email-capture__input"
        >
        <button type="submit" class="email-capture__button">
          {{ section.settings.button_text | default: 'Send it to me' }}
        </button>

        {%- if form.posted_successfully? -%}
          <p class="email-capture__message email-capture__message--success" role="status">
            {{ section.settings.success_message | default: 'Thank you. Check your inbox for the first email.' }}
          </p>
        {%- endif -%}

        {%- if form.errors -%}
          <p class="email-capture__message email-capture__message--error" role="alert">
            {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
          </p>
        {%- endif -%}
      {%- endform -%}
    </div>

    {%- if section.settings.privacy_text != blank -%}
      <p class="email-capture__privacy">{{ section.settings.privacy_text }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .email-capture {
    padding-block: 4rem;
  }

  .email-capture__inner {
    max-width: 560px;
    margin-inline: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .email-capture__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 0.75rem;
    font-weight: 500;
    margin: 0;
    opacity: 0.7;
  }

  .email-capture__heading {
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    margin: 0;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .email-capture__body {
    margin: 0;
    font-size: 1rem;
    line-height: 1.55;
    opacity: 0.85;
  }

  .email-capture__form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .email-capture__input {
    width: 100%;
    padding: 0.95rem 1rem;
    border: 1px solid currentColor;
    background: transparent;
    color: inherit;
    font-size: 1rem;
    border-radius: 2px;
    min-height: 48px;
  }

  .email-capture__input::placeholder {
    opacity: 0.6;
    color: inherit;
  }

  .email-capture__input:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .email-capture__button {
    width: 100%;
    padding: 0.95rem 1.5rem;
    background: var(--color-foreground, #111);
    color: var(--color-background, #fff);
    border: 1px solid var(--color-foreground, #111);
    font-size: 0.95rem;
    font-weight: 500;
    cursor: pointer;
    border-radius: 2px;
    min-height: 48px;
    transition: background-color 150ms ease, color 150ms ease;
  }

  .email-capture__button:hover,
  .email-capture__button:focus-visible {
    background: transparent;
    color: var(--color-foreground, #111);
  }

  .email-capture__button:focus-visible {
    outline: 2px solid var(--color-foreground, #111);
    outline-offset: 3px;
  }

  .email-capture__privacy {
    font-size: 0.8125rem;
    margin: 0;
    opacity: 0.7;
  }

  .email-capture__message {
    margin: 0.5rem 0 0;
    font-size: 0.9rem;
  }

  .email-capture__message--success {
    color: inherit;
  }

  .email-capture__message--error {
    color: #b00020;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (min-width: 750px) {
    .email-capture__form {
      flex-direction: row;
    }

    .email-capture__input {
      flex: 1;
    }

    .email-capture__button {
      width: auto;
      flex-shrink: 0;
    }

    .email-capture__message {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Email capture",
  "tag": "section",
  "class": "section-email-capture",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "The form below is a Shopify-native fallback. Once Klaviyo is installed, replace it with the Klaviyo embed at the placeholder comment."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Optional — leave blank to hide."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get our free 7-day meditation series and clean-beauty ingredient guide."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "info": "Optional — leave blank to hide."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "you@example.com"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button label",
      "default": "Send it to me"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you. Check your inbox for the first email."
    },
    {
      "type": "text",
      "id": "privacy_text",
      "label": "Privacy line",
      "default": "We'll never share your email. Unsubscribe anytime."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Email capture"
    }
  ]
}
{% endschema %}
