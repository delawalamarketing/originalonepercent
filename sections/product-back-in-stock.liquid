{%- liquid
  assign product = closest.product
  assign current_variant = product.selected_or_first_available_variant
  assign show = false
  if product != blank and product.available == false
    assign show = true
  endif
-%}

{%- if show -%}
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <section class="back-in-stock color-{{ section.settings.color_scheme }} page-width" aria-labelledby="back-in-stock-heading-{{ section.id }}">
    <div class="back-in-stock__inner">
      {%- if section.settings.eyebrow != blank -%}
        <p class="back-in-stock__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="back-in-stock__heading" id="back-in-stock-heading-{{ section.id }}">
          {{- section.settings.heading | replace: '{{ product }}', product.title -}}
        </h2>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <p class="back-in-stock__body">{{ section.settings.body }}</p>
      {%- endif -%}

      <div class="back-in-stock__form-wrapper">
        {%- comment -%} Klaviyo Back-in-Stock form embed goes here {%- endcomment -%}
        <!-- APP EMBED: Klaviyo Back-in-Stock form -->

        {%- form 'customer', id: 'BackInStock-' | append: section.id, class: 'back-in-stock__form' -%}
          <input type="hidden" name="contact[tags]" value="back-in-stock, {{ product.handle }}, variant-{{ current_variant.id }}">
          <input type="hidden" name="contact[note]" value="Notify when back: {{ product.title | escape }} (variant {{ current_variant.id }})">

          <label for="BackInStock-{{ section.id }}-email" class="visually-hidden">{{ section.settings.placeholder | default: 'Email' }}</label>
          <input
            id="BackInStock-{{ section.id }}-email"
            type="email"
            name="contact[email]"
            placeholder="{{ section.settings.placeholder | default: 'you@example.com' | escape }}"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            required
            class="back-in-stock__input"
          >
          <button type="submit" class="back-in-stock__button">
            {{ section.settings.button_text | default: 'Notify me' }}
          </button>

          {%- if form.posted_successfully? -%}
            <p class="back-in-stock__message back-in-stock__message--success" role="status">
              {{ section.settings.success_message }}
            </p>
          {%- endif -%}

          {%- if form.errors -%}
            <p class="back-in-stock__message back-in-stock__message--error" role="alert">
              {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
            </p>
          {%- endif -%}
        {%- endform -%}
      </div>

      {%- if section.settings.privacy_text != blank -%}
        <p class="back-in-stock__privacy">{{ section.settings.privacy_text }}</p>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .back-in-stock {
    padding-block: 2.5rem;
  }

  .back-in-stock__inner {
    max-width: 540px;
    margin-inline: auto;
    text-align: center;
    border: 1px solid rgb(var(--color-border-rgb, 0 0 0) / 0.2);
    border-radius: 4px;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .back-in-stock__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 0.75rem;
    font-weight: 500;
    margin: 0;
    opacity: 0.7;
  }

  .back-in-stock__heading {
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    margin: 0;
    line-height: 1.3;
    letter-spacing: -0.005em;
  }

  .back-in-stock__body {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    opacity: 0.85;
  }

  .back-in-stock__form {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-top: 0.5rem;
  }

  .back-in-stock__input {
    width: 100%;
    padding: 0.85rem 1rem;
    border: 1px solid currentColor;
    background: transparent;
    color: inherit;
    font-size: 1rem;
    border-radius: 2px;
    min-height: 48px;
  }

  .back-in-stock__input::placeholder {
    opacity: 0.6;
    color: inherit;
  }

  .back-in-stock__input:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .back-in-stock__button {
    width: 100%;
    padding: 0.85rem 1.5rem;
    background: var(--color-foreground, #111);
    color: var(--color-background, #fff);
    border: 1px solid var(--color-foreground, #111);
    font-size: 0.95rem;
    font-weight: 500;
    cursor: pointer;
    border-radius: 2px;
    min-height: 48px;
    transition: background-color 150ms ease, color 150ms ease;
  }

  .back-in-stock__button:hover,
  .back-in-stock__button:focus-visible {
    background: transparent;
    color: var(--color-foreground, #111);
  }

  .back-in-stock__button:focus-visible {
    outline: 2px solid var(--color-foreground, #111);
    outline-offset: 3px;
  }

  .back-in-stock__privacy {
    font-size: 0.8125rem;
    margin: 0;
    opacity: 0.65;
  }

  .back-in-stock__message {
    margin: 0.5rem 0 0;
    font-size: 0.9rem;
  }

  .back-in-stock__message--error {
    color: #b00020;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (min-width: 750px) {
    .back-in-stock__form {
      flex-direction: row;
    }
    .back-in-stock__input {
      flex: 1;
    }
    .back-in-stock__button {
      width: auto;
      flex-shrink: 0;
    }
    .back-in-stock__message {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Back-in-stock notify",
  "tag": "section",
  "class": "section-back-in-stock",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Renders only when the current product is unavailable. Once Klaviyo Back-in-Stock is installed, replace the comment placeholder in this section's code with the Klaviyo embed."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Optional — leave blank to hide."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Notify me when {{ product }} is back",
      "info": "Use {{ product }} as a placeholder for the product title."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "We'll email you the moment we have stock again. No spam, ever."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "you@example.com"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button label",
      "default": "Notify me"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "You're on the list. We'll email when this is back in stock."
    },
    {
      "type": "text",
      "id": "privacy_text",
      "label": "Privacy line",
      "default": "We'll only use your email to notify you about this product. Unsubscribe anytime."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Back-in-stock notify"
    }
  ]
}
{% endschema %}
