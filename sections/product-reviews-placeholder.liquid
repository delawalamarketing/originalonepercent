
<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section class="product-reviews-placeholder color-{{ section.settings.color_scheme }} page-width" aria-labelledby="product-reviews-heading-{{ section.id }}">
  {%- if section.settings.heading != blank -%}
    <h2 class="product-reviews-placeholder__heading" id="product-reviews-heading-{{ section.id }}">{{ section.settings.heading }}</h2>
  {%- else -%}
    <h2 class="visually-hidden" id="product-reviews-heading-{{ section.id }}">Reviews</h2>
  {%- endif -%}

  <div class="product-reviews-placeholder__widget">
    {%- comment -%} Judge.me / Loox / Klaviyo product reviews widget embed goes here {%- endcomment -%}
    <!-- APP EMBED: Product reviews widget (Judge.me <div id="judgeme_product_reviews"></div> or Loox embed) -->

    {%- if section.settings.show_empty_state -%}
      <p class="product-reviews-placeholder__empty">
        {{ section.settings.empty_text }}
      </p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .product-reviews-placeholder {
    padding-block: 3rem;
  }

  .product-reviews-placeholder__heading {
    text-align: center;
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin: 0 0 2rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .product-reviews-placeholder__widget {
    min-height: 60px;
  }

  .product-reviews-placeholder__empty {
    text-align: center;
    opacity: 0.6;
    margin: 0;
    font-size: 0.95rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product reviews placeholder",
  "tag": "section",
  "class": "section-product-reviews-placeholder",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Paste your reviews app embed (Judge.me, Loox, Klaviyo) into this section's HTML where the comment placeholder is."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Reviews"
    },
    {
      "type": "checkbox",
      "id": "show_empty_state",
      "label": "Show empty-state text",
      "default": true,
      "info": "Disable once your reviews app is live."
    },
    {
      "type": "textarea",
      "id": "empty_text",
      "label": "Empty-state text",
      "default": "Reviews will appear here once your review widget is installed."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Product reviews placeholder"
    }
  ]
}
{% endschema %}
