
<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section class="books-feature color-{{ section.settings.color_scheme }} page-width">
  <header class="books-feature__header">
    {%- if section.settings.eyebrow != blank -%}
      <p class="books-feature__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="books-feature__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
  </header>

  {%- assign book_fallbacks = 'book-junk-to-genius.png,book-saqi.jpg' | split: ',' -%}
  <div class="books-feature__grid">
    {%- for block in section.blocks -%}
      {%- assign fallback_book = book_fallbacks[forloop.index0] -%}
      <article class="books-feature__card" {{ block.shopify_attributes }}>
        <div class="books-feature__media">
          {%- if block.settings.cover_image != blank -%}
            {{
              block.settings.cover_image
              | image_url: width: 800
              | image_tag:
                loading: 'lazy',
                sizes: '(min-width: 750px) 40vw, 80vw',
                widths: '300, 480, 600, 800',
                class: 'books-feature__image',
                alt: block.settings.cover_image.alt | default: block.settings.title
            }}
          {%- elsif fallback_book != blank -%}
            <img
              src="{{ fallback_book | asset_url }}"
              alt="{{ block.settings.title | escape }}"
              class="books-feature__image"
              loading="lazy"
              width="800"
              height="1067"
            >
          {%- else -%}
            <div class="books-feature__image books-feature__image--placeholder" aria-hidden="true"></div>
          {%- endif -%}
        </div>

        <div class="books-feature__body">
          {%- if block.settings.title != blank -%}
            <h3 class="books-feature__title">{{ block.settings.title }}</h3>
          {%- endif -%}

          {%- if block.settings.subtitle != blank -%}
            <p class="books-feature__subtitle">{{ block.settings.subtitle }}</p>
          {%- endif -%}

          {%- if block.settings.pull_quote != blank -%}
            <blockquote class="books-feature__quote">
              {{ block.settings.pull_quote }}
            </blockquote>
          {%- endif -%}

          {%- if block.settings.cta_text != blank -%}
            <a href="{{ block.settings.cta_link | default: '#' }}" class="books-feature__cta">
              {{ block.settings.cta_text }}
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M3 7h8m0 0L8 4m3 3L8 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          {%- endif -%}
        </div>
      </article>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .books-feature {
    padding-block: 4rem;
  }

  .books-feature__header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .books-feature__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 0.75rem;
    font-weight: 500;
    margin: 0 0 0.75rem;
    opacity: 0.7;
  }

  .books-feature__heading {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .books-feature__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  .books-feature__card {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .books-feature__media {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.04);
    max-width: 320px;
    margin-inline: auto;
    width: 100%;
  }

  .books-feature__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .books-feature__image--placeholder {
    background: linear-gradient(135deg, rgba(0,0,0,0.08), rgba(0,0,0,0.02));
  }

  .books-feature__body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    text-align: center;
  }

  .books-feature__title {
    font-size: 1.375rem;
    font-weight: 500;
    margin: 0;
    line-height: 1.25;
  }

  .books-feature__subtitle {
    font-size: 0.9375rem;
    margin: 0;
    opacity: 0.7;
  }

  .books-feature__quote {
    font-size: 1.0625rem;
    line-height: 1.55;
    font-style: italic;
    margin: 0.5rem 0;
    padding-inline: 1rem;
    opacity: 0.9;
  }

  .books-feature__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.5rem;
    margin-inline: auto;
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 4px;
    color: inherit;
  }

  .books-feature__cta:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .books-feature__cta:hover svg {
    transform: translateX(3px);
  }

  .books-feature__cta svg {
    transition: transform 150ms ease;
  }

  @media (min-width: 750px) {
    .books-feature__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 3rem 2rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Books feature",
  "tag": "section",
  "class": "section-books-feature",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Read"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Books from our founder."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "book",
      "name": "Book",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "cover_image",
          "label": "Cover image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "textarea",
          "id": "pull_quote",
          "label": "Pull quote"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "CTA label",
          "default": "Read a chapter free"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "CTA link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Books feature",
      "blocks": [
        {
          "type": "book",
          "settings": {
            "title": "Original 1%: From Junk to Genius"
          }
        },
        {
          "type": "book",
          "settings": {
            "title": "Second title"
          }
        }
      ]
    }
  ]
}
{% endschema %}
