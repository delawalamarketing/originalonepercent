
<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section class="trust-pillars color-{{ section.settings.color_scheme }} page-width">
  {%- if section.settings.heading != blank -%}
    <h2 class="trust-pillars__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  {%- assign pillar_icons = 'maple,certificate,esthetician' | split: ',' -%}
  <div class="trust-pillars__grid" role="list">
    {%- for block in section.blocks -%}
      {%- assign fallback_icon = pillar_icons[forloop.index0] -%}
      <div class="trust-pillars__item" role="listitem" {{ block.shopify_attributes }}>
        {%- if block.settings.icon != blank -%}
          <div class="trust-pillars__icon" aria-hidden="true">
            {{
              block.settings.icon
              | image_url: width: 96
              | image_tag:
                loading: 'lazy',
                widths: '48, 96, 144',
                sizes: '48px',
                alt: ''
            }}
          </div>
        {%- else -%}
          <div class="trust-pillars__icon" aria-hidden="true">
            {%- if fallback_icon == 'maple' -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="currentColor" width="48" height="48" aria-hidden="true">
                <path d="M24 4l3.5 8.5 7-3-4.5 7.5 9 1-6 5 2.5 8.5-7.5-4L24 38l-4-10.5-7.5 4 2.5-8.5-6-5 9-1-4.5-7.5 7 3L24 4zm0 30v10"/>
              </svg>
            {%- elsif fallback_icon == 'certificate' -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="48" height="48" aria-hidden="true">
                <rect x="4" y="6" width="40" height="28" rx="2"/>
                <circle cx="24" cy="20" r="7"/>
                <path d="M18 34v8l6-3 6 3v-8"/>
                <path d="M8 14h4M8 20h4M8 26h4M36 14h4M36 20h4M36 26h4"/>
              </svg>
            {%- elsif fallback_icon == 'esthetician' -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="48" height="48" aria-hidden="true">
                <circle cx="24" cy="14" r="8"/>
                <path d="M8 42c0-8.837 7.163-16 16-16s16 7.163 16 16"/>
                <path d="M20 30l4 4 4-4"/>
              </svg>
            {%- else -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" width="48" height="48" aria-hidden="true">
                <circle cx="24" cy="24" r="20"/>
                <path d="M16 24l6 6 10-12" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if block.settings.heading != blank -%}
          <h3 class="trust-pillars__item-heading">{{ block.settings.heading }}</h3>
        {%- endif -%}

        {%- if block.settings.description != blank -%}
          <p class="trust-pillars__item-description">{{ block.settings.description }}</p>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .trust-pillars {
    padding-block: var(--trust-padding-block, 3rem);
  }

  .trust-pillars__heading {
    text-align: center;
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    font-weight: 500;
    margin: 0 0 2.5rem;
    letter-spacing: -0.005em;
  }

  .trust-pillars__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .trust-pillars__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.75rem;
    padding-inline: 1rem;
  }

  .trust-pillars__icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .trust-pillars__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .trust-pillars__item-heading {
    font-size: 1.0625rem;
    font-weight: 500;
    margin: 0;
    line-height: 1.3;
  }

  .trust-pillars__item-description {
    font-size: 0.9375rem;
    line-height: 1.5;
    margin: 0;
    max-width: 32ch;
    opacity: 0.85;
  }

  @media (min-width: 750px) {
    .trust-pillars__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trust Pillars",
  "tag": "section",
  "class": "section-trust-pillars",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Optional — leave blank to hide."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon (SVG recommended)",
          "info": "Square, 48×48 minimum. SVG preferred."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Pillars",
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "heading": "Made in Canada",
            "description": "Hand-formulated and bottled in our Ontario lab."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "heading": "ECOCERT & Health Canada GMP",
            "description": "Manufactured under independent quality certifications."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "heading": "Formulated by an Esthetician",
            "description": "Every product designed by a certified skincare professional."
          }
        }
      ]
    }
  ]
}
{% endschema %}
