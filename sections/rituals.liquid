
<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section class="rituals color-{{ section.settings.color_scheme }} page-width">
  <header class="rituals__header">
    {%- if section.settings.eyebrow != blank -%}
      <p class="rituals__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="rituals__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="rituals__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
  </header>

  {%- assign ritual_fallbacks = 'ritual-morning.png,ritual-inner-work.png,ritual-survivors.jpg' | split: ',' -%}
  <div class="rituals__grid">
    {%- for block in section.blocks -%}
      {%- assign fallback_img = ritual_fallbacks[forloop.index0] -%}
      <article class="rituals__card" {{ block.shopify_attributes }}>
        <a href="{{ block.settings.link | default: '#' }}" class="rituals__card-link" aria-label="{{ block.settings.title | escape }} — {{ block.settings.cta_text | default: 'Build this ritual' | escape }}">
          <div class="rituals__card-media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                  widths: '375, 540, 750, 990, 1200',
                  class: 'rituals__card-image',
                  alt: block.settings.image.alt | default: block.settings.title
              }}
            {%- elsif fallback_img != blank -%}
              <img
                src="{{ fallback_img | asset_url }}"
                alt="{{ block.settings.title | escape }}"
                class="rituals__card-image"
                loading="lazy"
                width="1200"
                height="900"
              >
            {%- else -%}
              <div class="rituals__card-image rituals__card-image--placeholder" aria-hidden="true"></div>
            {%- endif -%}

            {%- if block.settings.savings_badge_text != blank -%}
              <span class="rituals__badge">{{ block.settings.savings_badge_text }}</span>
            {%- endif -%}
          </div>

          <div class="rituals__card-body">
            {%- if block.settings.title != blank -%}
              <h3 class="rituals__card-title">{{ block.settings.title }}</h3>
            {%- endif -%}

            {%- if block.settings.description != blank -%}
              <p class="rituals__card-description">{{ block.settings.description }}</p>
            {%- endif -%}

            <div class="rituals__card-footer">
              {%- if block.settings.price != blank -%}
                <span class="rituals__card-price">{{ block.settings.price }}</span>
              {%- endif -%}
              <span class="rituals__card-cta">
                {{ block.settings.cta_text | default: 'Build this ritual' }}
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M3 7h8m0 0L8 4m3 3L8 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
          </div>
        </a>
      </article>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .rituals {
    padding-block: 4rem;
  }

  .rituals__header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 2.5rem;
  }

  .rituals__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 0.75rem;
    font-weight: 500;
    margin: 0 0 0.75rem;
    opacity: 0.7;
  }

  .rituals__heading {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0 0 0.75rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .rituals__subheading {
    font-size: 1rem;
    line-height: 1.55;
    margin: 0;
    opacity: 0.85;
  }

  .rituals__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .rituals__card {
    border-radius: 4px;
    overflow: hidden;
    background: var(--color-background, #fff);
    transition: transform 200ms ease, box-shadow 200ms ease;
  }

  .rituals__card:hover {
    transform: translateY(-2px);
  }

  .rituals__card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .rituals__card-link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .rituals__card-media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.04);
  }

  .rituals__card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rituals__card-image--placeholder {
    background: linear-gradient(135deg, rgba(0,0,0,0.08), rgba(0,0,0,0.02));
  }

  .rituals__badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background: #111;
    color: #fff;
    padding: 0.35rem 0.7rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    border-radius: 2px;
  }

  .rituals__card-body {
    padding: 1.25rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .rituals__card-title {
    font-size: 1.125rem;
    font-weight: 500;
    margin: 0;
    line-height: 1.3;
  }

  .rituals__card-description {
    font-size: 0.9375rem;
    line-height: 1.5;
    margin: 0;
    opacity: 0.85;
    flex: 1;
  }

  .rituals__card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.5rem;
    gap: 1rem;
  }

  .rituals__card-price {
    font-size: 1rem;
    font-weight: 500;
  }

  .rituals__card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .rituals__card-link:hover .rituals__card-cta svg {
    transform: translateX(3px);
  }

  .rituals__card-cta svg {
    transition: transform 150ms ease;
  }

  @media (min-width: 750px) {
    .rituals__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.75rem;
    }
  }

  @media (min-width: 990px) {
    .rituals__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Rituals",
  "tag": "section",
  "class": "section-rituals",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Rituals"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Three rituals, made for the seasons of you."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Curated bundles for stillness, healing, and the work that's quietly internal."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "ritual",
      "name": "Ritual card",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price (display only)",
          "info": "Cosmetic — for live product pricing use a Bundle product instead."
        },
        {
          "type": "text",
          "id": "savings_badge_text",
          "label": "Savings badge",
          "info": "e.g. \"Save 10%\""
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "CTA label",
          "default": "Build this ritual"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rituals",
      "blocks": [
        {
          "type": "ritual",
          "settings": {
            "title": "The Morning Ritual",
            "description": "Begin the day with five minutes of stillness and skin that feels alive."
          }
        },
        {
          "type": "ritual",
          "settings": {
            "title": "The Inner Work Bundle",
            "description": "For the seasons when the work is internal."
          }
        },
        {
          "type": "ritual",
          "settings": {
            "title": "The Survivor's Set",
            "description": "Made for skin that's been through something. Fragrance-free, gentle, gift-ready."
          }
        }
      ]
    }
  ]
}
{% endschema %}
